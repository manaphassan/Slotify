<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_card"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/widget_child_header_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_app_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SLOTIFY"
                android:textColor="#0052CC"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_child_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Slotify"
                android:textColor="#1E293B"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Child Switcher Button -->
        <TextView
            android:id="@+id/widget_switch_child_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_widget_switch"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="7dp"
            android:paddingVertical="3dp"
            android:text="⇄ Tukar"
            android:textColor="#0052CC"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_live_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_widget_live"
            android:paddingHorizontal="6dp"
            android:paddingVertical="3dp"
            android:text="● LIVE"
            android:textColor="#137333"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Live Proximity Zone Row (Deep Link to Logistics Map) -->
    <LinearLayout
        android:id="@+id/widget_zone_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_widget_zone"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp">

        <TextView
            android:id="@+id/widget_zone_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="📍 Zon"
            android:textColor="#0369A1"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_zone_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Peta 🗺️"
            android:textColor="#0284C7"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="5dp"
        android:background="#E2E8F0" />

    <!-- Current Ongoing Class -->
    <TextView
        android:id="@+id/widget_current_class"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="⏳ Matematik (08:00 - 09:00)"
        android:textColor="#0F172A"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- Next Class -->
    <TextView
        android:id="@+id/widget_next_class"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="⏩ Seterusnya: Sains (09:00 - 10:00)"
        android:textColor="#475569"
        android:textSize="11sp" />

    <!-- Required Books -->
    <TextView
        android:id="@+id/widget_books"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="📚 Bawa: Buku Teks Sains Jilid 1"
        android:textColor="#0052CC"
        android:textSize="11sp" />

    <!-- Multi-Child Sibling Summary Row -->
    <TextView
        android:id="@+id/widget_siblings_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_widget_siblings"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingHorizontal="6dp"
        android:paddingVertical="3dp"
        android:text=""
        android:textColor="#475569"
        android:textSize="9.5sp"
        android:textStyle="bold" />

    <!-- Attire & Action Footer -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_attire"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="👕 Uniform Penuh KPM"
            android:textColor="#64748B"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_open_action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Jadual ➔"
            android:textColor="#0052CC"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
